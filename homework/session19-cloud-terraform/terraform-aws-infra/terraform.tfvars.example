# Copy to terraform.tfvars and adjust.
aws_region         = "ap-south-1"
project_name       = "session19-infra"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "ap-south-1a"
instance_type      = "t3.micro"
allowed_ssh_cidr   = "203.0.113.10/32" # replace with: $(curl -s https://checkip.amazonaws.com)/32
key_name           = null              # or the name of an existing EC2 key pair, e.g. "om-session19-key"
bucket_prefix      = "session19-infra"

tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
  Owner       = "Om Malviya"
}

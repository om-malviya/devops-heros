# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# BACKEND_HOST / BACKEND_PORT are set per environment:
#   docker compose : backend / 8000
#   kubernetes     : taskboard-backend / 8000 (ConfigMap)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  # Proxy API calls to the FastAPI backend so the browser only talks to one origin.
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /healthz {
    access_log off;
    return 200 "ok\n";
    add_header Content-Type text/plain;
  }
}
